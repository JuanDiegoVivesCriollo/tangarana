---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  items: FAQ[];
  headingLevel?: "h2" | "h3";
}

const { items, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<div class="faq-list">
  {items.map((item, index) => (
    <details open={index === 0}>
      <summary><Heading>{item.question}</Heading><span aria-hidden="true">+</span></summary>
      <div class="faq-list__answer"><p>{item.answer}</p></div>
    </details>
  ))}
</div>
