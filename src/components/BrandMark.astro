---
import { Picture } from "astro:assets";
import logo from "../assets/brand/tangarana-logo-hd.png";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="brand-mark" href="/" title="Volver al inicio">
  <Picture
    class:list={["brand-mark__logo", compact && "brand-mark__logo--compact"]}
    src={logo}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={compact ? [160, 240, 320] : [180, 280, 400]}
    sizes={compact ? "(max-width: 767px) 160px, 128px" : "(max-width: 767px) 120px, 208px"}
    alt="Tangarana Travel Tours"
    loading="eager"
    decoding="async"
  />
</a>
