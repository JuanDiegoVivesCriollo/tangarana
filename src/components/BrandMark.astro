---
import { Image } from "astro:assets";
import logo from "../assets/brand/tangarana-logo.webp";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class="brand-mark" href="/" title="Volver al inicio">
  <Image
    class:list={["brand-mark__logo", compact && "brand-mark__logo--compact"]}
    src={logo}
    alt="Tangarana Travel Tours"
    width={compact ? 78 : 154}
    height={compact ? 52 : 103}
    loading="eager"
  />
</a>
