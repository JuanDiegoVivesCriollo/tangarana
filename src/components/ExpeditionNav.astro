---
import ThemeToggle from "./ThemeToggle.astro";
import BrandMark from "./BrandMark.astro";
import { Menu } from "@lucide/astro";
import { mainNavigation } from "../data/navigation";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname;
const current = (href: string) => href === "/" ? pathname === href : pathname.startsWith(href);
---

<nav class="expedition-nav" aria-label="Navegación principal">
  <div class="expedition-nav__brand"><BrandMark /></div>
  <ul>
    {mainNavigation.map((item) => (
      <li>
        <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
      </li>
    ))}
    <li><ThemeToggle /></li>
  </ul>
</nav>

<header class="mobile-header">
  <BrandMark compact />
  <nav class="mobile-header__socials" aria-label="Redes sociales">
    <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke-width="2" aria-hidden="true"><defs><linearGradient id="instagram-mobile-gradient" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#FFD600"/><stop offset=".46" stop-color="#FF0169"/><stop offset="1" stop-color="#7638FA"/></linearGradient></defs><rect x="3" y="3" width="18" height="18" rx="5" stroke="url(#instagram-mobile-gradient)"/><circle cx="12" cy="12" r="4" stroke="url(#instagram-mobile-gradient)"/><circle cx="17.4" cy="6.7" r="1.15" fill="#FF0169" stroke="none"/></svg></a>
    <a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" width="19" height="19" fill="#1877F2" aria-hidden="true"><path d="M13.8 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5H17V3.6c-.7-.1-1.5-.2-2.3-.2-2.3 0-3.9 1.4-3.9 4.1v2.4H8.2V13h2.6v8h3Z"/></svg></a>
    <a href={siteConfig.socials.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M15 3c.4 2.1 1.6 3.3 3.8 3.7v3a9 9 0 0 1-3.8-1.1v6.1a6 6 0 1 1-5.2-5.9v3a3 3 0 1 0 2.2 2.9V3h3Z" fill="#25F4EE" transform="translate(-.45 .28)"/><path d="M15 3c.4 2.1 1.6 3.3 3.8 3.7v3a9 9 0 0 1-3.8-1.1v6.1a6 6 0 1 1-5.2-5.9v3a3 3 0 1 0 2.2 2.9V3h3Z" fill="#FE2C55" transform="translate(.45 -.18)"/><path d="M15 3c.4 2.1 1.6 3.3 3.8 3.7v3a9 9 0 0 1-3.8-1.1v6.1a6 6 0 1 1-5.2-5.9v3a3 3 0 1 0 2.2 2.9V3h3Z" fill="currentColor"/></svg></a>
  </nav>
  <div class="mobile-header__controls">
    <ThemeToggle />
    <details class="mobile-header__menu">
      <summary aria-label="Abrir menú"><Menu size={24} aria-hidden="true" /><span>Menú</span></summary>
      <nav class="mobile-menu" aria-label="Menú móvil">
        {mainNavigation.map((item) => (
          <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
        <a href="/preguntas-frecuentes/">Preguntas frecuentes</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const mobileHeader = document.querySelector<HTMLElement>(".mobile-header");

  if (mobileHeader && mobileHeader.dataset.scrollReady !== "true") {
    mobileHeader.dataset.scrollReady = "true";
    const updateHeader = () => mobileHeader.classList.toggle("is-scrolled", window.scrollY > 48);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  }
</script>
