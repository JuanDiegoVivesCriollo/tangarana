---
import { ArrowRight } from "@lucide/astro";

interface Props {
  label?: string;
  tourSlug?: string;
  class?: string;
}

const {
  label = "Reservar ahora",
  tourSlug,
  class: className = "button-primary",
} = Astro.props;
---

<button
  class:list={["button", "reserve-button", className]}
  type="button"
  data-open-reservation
  data-tour-slug={tourSlug}
  aria-haspopup="dialog"
  aria-controls="reservation-dialog"
>
  <span>{label}</span>
  <ArrowRight size={19} aria-hidden="true" />
</button>
