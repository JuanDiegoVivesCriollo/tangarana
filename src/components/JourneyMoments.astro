---
import { Picture } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { journeyMoments } from "../data/images";

interface Props {
  id: string;
  variant?: "mosaic" | "ribbon";
}

const { id, variant = "mosaic" } = Astro.props;
---

<section class:list={["section", "section--soft", "journey-moments", `journey-moments--${variant}`]} aria-labelledby={id}>
  <div class="container">
    <SectionHeading eyebrow="Viajeros de Tangarana" title="Fotografías de tours y actividades" id={id}>
      <p>Grupos de viajeros en cascadas, lagunas y experiencias culturales de la Selva Central.</p>
    </SectionHeading>

    <div class="journey-moments__grid">
      {journeyMoments.map((moment, index) => (
        <figure>
          <Picture
            src={moment.image.src}
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[360, 560, 760, 960]}
            sizes={variant === "ribbon" ? "(min-width: 768px) 25vw, 72vw" : index === 0 ? "(min-width: 768px) 52vw, 88vw" : "(min-width: 768px) 24vw, 72vw"}
            alt={moment.image.alt}
            loading="lazy"
          />
          <figcaption>{moment.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
