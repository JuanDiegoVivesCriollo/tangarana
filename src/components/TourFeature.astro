---
import { Picture } from "astro:assets";
import { ArrowUpRight, BedDouble, CalendarDays } from "@lucide/astro";
import PriceBadge from "./PriceBadge.astro";
import ExpeditionTimeline from "./ExpeditionTimeline.astro";
import ReserveButton from "./ReserveButton.astro";
import { packageCover } from "../data/packageMedia";

interface Props {
  tour: {
    slug: string;
    commercialName: string;
    price: number;
    currency: string;
    durationDays?: number;
    durationNights?: number;
    itinerary: { day: number; destination: string }[];
  };
}

const { tour } = Astro.props;
const cover = packageCover(tour.slug);
---

<article class="tour-feature">
  <div class="tour-feature__photo">
    {cover && <Picture
      src={cover.src}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 720, 960]}
      sizes="(min-width: 768px) 44vw, 100vw"
      alt={cover.alt}
      loading="lazy"
    />}
    <PriceBadge price={tour.price} currency={tour.currency} />
  </div>
  <div class="tour-feature__content">
    <span class="eyebrow">Paquete por la Selva Central</span>
    <h2>{tour.commercialName}</h2>
    <div class="tour-feature__facts">
      <span><CalendarDays size={19} aria-hidden="true" /> {tour.durationDays ?? 4} días</span>
      <span><BedDouble size={19} aria-hidden="true" /> {tour.durationNights ?? 3} noches</span>
    </div>
    <ExpeditionTimeline stops={tour.itinerary} compact />
    <div class="tour-feature__actions">
      <ReserveButton label="Reservar este paquete" tourSlug={tour.slug} />
      <a class="text-link" href={`/tours/${tour.slug}/`}>Ver paquete de 4 días <ArrowUpRight size={19} aria-hidden="true" /></a>
    </div>
  </div>
</article>
