---
import { getImage } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import BrandMark from "./BrandMark.astro";
import { homeHeroMobile, siteImages } from "../data/images";

const [heroDesktopAvif, heroDesktopWebp, heroMobileAvif, heroMobileWebp] = await Promise.all([
  getImage({ src: siteImages.hero.src, width: 1024, format: "avif", quality: 76 }),
  getImage({ src: siteImages.hero.src, width: 1024, format: "webp", quality: 82 }),
  getImage({ src: homeHeroMobile.src, width: 720, format: "avif", quality: 76 }),
  getImage({ src: homeHeroMobile.src, width: 720, format: "webp", quality: 82 }),
]);
---

<header class="hero">
  <picture class="hero-media">
    <source media="(max-width: 47.99rem)" type="image/avif" srcset={heroMobileAvif.src} />
    <source media="(max-width: 47.99rem)" type="image/webp" srcset={heroMobileWebp.src} />
    <source type="image/avif" srcset={heroDesktopAvif.src} />
    <img src={heroDesktopWebp.src} width="1024" height="683" alt={siteImages.hero.alt} loading="eager" decoding="async" fetchpriority="high" />
  </picture>
  <svg class="topography" viewBox="0 0 1200 700" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1">
      <path d="M-90 170C120 30 205 300 422 150S775 30 960 170s265 12 350-55" />
      <path d="M-100 220C110 80 225 350 445 200S785 80 975 225s265 10 345-60" />
      <path d="M-100 270C100 130 245 400 470 250S800 130 990 280s260 8 340-55" />
      <path d="M-120 525C80 370 205 650 400 505s360-135 540 20 280 35 370-50" />
      <path d="M-130 575C70 420 225 700 425 555s350-125 530 25 285 30 380-55" />
    </g>
  </svg>
  <div class="hero__brand"><BrandMark /></div>
  <div class="hero__inner container">
    <div class="hero__content">
      <div class="hero__intro">
        <span class="eyebrow">Agencia de tours y paquetes en Oxapampa</span>
        <h1>Tours en Oxapampa y la Selva Central</h1>
        <p class="hero-display">Tours por destino y paquetes completos.</p>
        <p class="hero__lead">Elige recorridos de un día o programas con alojamiento, desayunos y traslados.</p>
      </div>
      <div class="hero__conversion">
        <div class="hero__actions">
          <a class="button button-primary" href="/paquetes/">Ver paquetes <ArrowRight size={20} aria-hidden="true" /></a>
          <a class="button button-secondary" href="/tours/">Ver tours <ArrowRight size={20} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </div>
</header>
