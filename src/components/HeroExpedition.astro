---
import { Picture } from "astro:assets";
import { ArrowDown, ArrowRight, BusFront } from "@lucide/astro";
import BrandMark from "./BrandMark.astro";
import { siteImages } from "../data/images";
---

<header class="hero">
  <Picture
    src={siteImages.hero.src}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    alt={siteImages.hero.alt}
    loading="eager"
    fetchpriority="high"
    class="hero-media"
  />
  <svg class="topography" viewBox="0 0 1200 700" preserveAspectRatio="none" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1">
      <path d="M-90 170C120 30 205 300 422 150S775 30 960 170s265 12 350-55" />
      <path d="M-100 220C110 80 225 350 445 200S785 80 975 225s265 10 345-60" />
      <path d="M-100 270C100 130 245 400 470 250S800 130 990 280s260 8 340-55" />
      <path d="M-120 525C80 370 205 650 400 505s360-135 540 20 280 35 370-50" />
      <path d="M-130 575C70 420 225 700 425 555s350-125 530 25 285 30 380-55" />
    </g>
  </svg>
  <div class="hero__brand"><BrandMark /></div>
  <div class="hero__inner container">
    <div class="hero__content">
      <span class="eyebrow">Agencia de tours en Oxapampa</span>
      <h1>Tours en Oxapampa y la Selva Central</h1>
      <p class="hero-display">Abre el mapa. Empieza la ruta.</p>
      <p class="hero__lead">Descubre tours por Pozuzo, Villa Rica, el Valle del Perené, Chontabamba y Catarata Río Tigre con Tangarana Travel Tours.</p>
      <div class="hero__actions">
        <a class="button button-primary" href="/tours/">Ver todos los tours <ArrowRight size={20} aria-hidden="true" /></a>
      </div>
      <nav class="hero__tour-links" aria-label="Ir directamente a un tour">
        <a href="/tours/pozuzo/">Ir a Pozuzo</a>
        <a href="/tours/villa-rica/">Ir a Villa Rica</a>
        <a href="/tours/perene/">Ir a Perené</a>
        <a href="/tours/chontabamba/">Ir a Chontabamba</a>
        <a href="/tours/catarata-rio-tigre/">Ir a Río Tigre</a>
      </nav>
      <span class="route-stamp"><BusFront size={19} stroke-width={1.7} aria-hidden="true" /> Transporte turístico · Tours de un día · Circuito de 4 días</span>
    </div>
  </div>
  <a class="scroll-cue" href="#ruta">Ver tours destacados <ArrowDown size={18} aria-hidden="true" /></a>
</header>
