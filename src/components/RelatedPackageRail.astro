---
import { Picture } from "astro:assets";
import { ArrowUpRight, ChevronLeft, ChevronRight } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { packageCover } from "../data/packageMedia";

interface Props {
  items: CollectionEntry<"tours">["data"][];
}

const { items } = Astro.props;
---

<div class="related-package" data-related-package>
  <div class="related-package__controls">
    <button type="button" data-related-previous aria-label="Ver tours anteriores"><ChevronLeft size={20} aria-hidden="true" /></button>
    <button type="button" data-related-next aria-label="Ver más tours"><ChevronRight size={20} aria-hidden="true" /></button>
  </div>
  <div class="related-package__rail" data-related-rail data-lenis-prevent>
    {items.map((item) => {
      const cover = packageCover(item.slug);
      return (
        <a class="related-package__card" href={`/tours/${item.slug}/`} draggable="false">
          {cover && <Picture src={cover.src} formats={["avif"]} fallbackFormat="webp" widths={[420, 620]} sizes="(min-width: 960px) 30vw, 78vw" alt={cover.alt} loading="lazy" />}
          <span class="related-package__shade"></span>
          <span class="related-package__content">
            <small>{item.durationLabel}</small>
            <strong>{item.commercialName}</strong>
            <span>S/{item.price} por persona <ArrowUpRight size={17} aria-hidden="true" /></span>
          </span>
        </a>
      );
    })}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-related-package]").forEach((component) => {
    const rail = component.querySelector<HTMLElement>("[data-related-rail]");
    if (!rail) return;
    let timer = 0;
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = false;

    const step = () => rail.querySelector<HTMLElement>(".related-package__card")?.offsetWidth ?? 320;
    const move = (direction: number) => {
      const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 8;
      rail.scrollTo({ left: direction > 0 && atEnd ? 0 : Math.max(0, rail.scrollLeft + direction * (step() + 16)), behavior: "smooth" });
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) timer = window.setInterval(() => move(1), 1800);
    };

    component.querySelector("[data-related-previous]")?.addEventListener("click", () => { move(-1); start(); });
    component.querySelector("[data-related-next]")?.addEventListener("click", () => { move(1); start(); });
    rail.addEventListener("mouseenter", stop);
    rail.addEventListener("mouseleave", start);
    rail.addEventListener("pointerdown", (event) => {
      dragging = true;
      moved = false;
      startX = event.clientX;
      startScroll = rail.scrollLeft;
      stop();
    });
    rail.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const distance = event.clientX - startX;
      if (Math.abs(distance) > 8 && !moved) {
        moved = true;
        rail.classList.add("is-dragging");
        rail.setPointerCapture(event.pointerId);
      }
      if (!moved) return;
      rail.scrollLeft = startScroll - distance;
    });
    rail.addEventListener("pointerup", (event) => {
      dragging = false;
      rail.classList.remove("is-dragging");
      if (rail.hasPointerCapture(event.pointerId)) rail.releasePointerCapture(event.pointerId);
      start();
    });
    rail.addEventListener("pointercancel", (event) => {
      dragging = false;
      moved = true;
      rail.classList.remove("is-dragging");
      if (rail.hasPointerCapture(event.pointerId)) rail.releasePointerCapture(event.pointerId);
      start();
    });
    rail.addEventListener("click", (event) => {
      if (moved) event.preventDefault();
      moved = false;
    });
    start();
  });
</script>
