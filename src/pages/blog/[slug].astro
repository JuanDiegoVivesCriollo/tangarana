---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts, type BlogPost } from "../../data/blog";

export function getStaticPaths() {
  return blogPosts
    .filter((post) => !post.draft)
    .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
---

<BaseLayout title={post.title} description={post.description} canonicalPath={`/blog/${post.slug}/`}>
  <article class="section container content-copy">
    <h1>{post.title}</h1>
    <p>{post.description}</p>
  </article>
</BaseLayout>
