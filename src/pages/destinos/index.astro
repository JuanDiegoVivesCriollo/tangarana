---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import DestinationEditorial from "../../components/DestinationEditorial.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import JungleInterlude from "../../components/JungleInterlude.astro";
import { destinations } from "../../data/destinations";
---

<BaseLayout
  title="Destinos de la Selva Central | Tangarana Travel Tours"
  description="Conoce Oxapampa, Pozuzo, Villa Rica y el Valle del Perené. Consulta información de cada destino y encuentra los tours relacionados de Tangarana Travel Tours."
>
  <PageIntro
    eyebrow="Información de destinos"
    title="Destinos de la Selva Central"
    description="Conoce Oxapampa, Pozuzo, Villa Rica y el Valle del Perené, y encuentra los tours disponibles para cada destino."
    crumbs={[{ label: "Inicio", href: "/" }, { label: "Destinos" }]}
    tone="river"
    variant="destinations"
    image="oxapampaGroup"
    secondaryImage="pozuzoGate"
    marker="04"
    note="Oxapampa · Pozuzo · Villa Rica · Perené"
  />
  <section class="section" aria-labelledby="destinations-map-title">
    <div class="container">
      <SectionHeading eyebrow="Cuatro destinos" title="Información turística y tours relacionados" id="destinations-map-title">
        <p>Cada página explica qué experiencias ofrece Tangarana en el destino y enlaza al tour correspondiente.</p>
      </SectionHeading>
      <DestinationEditorial destinations={destinations} />
    </div>
  </section>
  <JungleInterlude variant="to-sun" />
  <section class="cta-route" aria-labelledby="destinations-cta-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">Elige un tour</span><h2 id="destinations-cta-title">Compara precios, horarios e itinerarios</h2></div>
      <div class="cta-route__actions"><a class="button button-dark" href="/tours/">Ver todos los tours</a><WhatsAppCTA label="Consultar por WhatsApp" /></div>
    </div>
  </section>
</BaseLayout>
