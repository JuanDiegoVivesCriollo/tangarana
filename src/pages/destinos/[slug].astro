---
import { Picture } from "astro:assets";
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandMark from "../../components/BrandMark.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import JungleInterlude from "../../components/JungleInterlude.astro";
import { destinations, type Destination } from "../../data/destinations";
import { siteImages } from "../../data/images";
import { SITE_URL } from "../../data/site";

export function getStaticPaths() {
  return destinations.map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}

const { destination } = Astro.props as { destination: Destination };
const image = siteImages[destination.image];
const related = destinations.filter((item) => item.slug !== destination.slug);
const tone = destination.layout === "earth" ? "earth" : destination.layout === "river" ? "river" : "forest";
const canonicalPath = `/destinos/${destination.slug}/`;
const schema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  name: destination.name,
  description: destination.seoDescription,
  url: new URL(canonicalPath, SITE_URL).toString(),
  image: new URL(image.src.src, SITE_URL).toString(),
};
---

<BaseLayout title={destination.seoTitle} description={destination.seoDescription} canonicalPath={canonicalPath} bodyClass={`destination-page--${destination.layout}`} schema={schema} socialImage={image.src.src} socialImageAlt={image.alt}>
  <header class="destination-hero">
    <Picture src={image.src} formats={["avif"]} fallbackFormat="webp" widths={[640, 960, 1280, 1600]} sizes="100vw" alt={image.alt} loading="eager" fetchpriority="high" />
    <div class="destination-hero__top container"><BrandMark /></div>
    <div class="destination-hero__content container">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Destinos", href: "/destinos/" }, { label: destination.name }]} />
      <span class="eyebrow">{destination.eyebrow}</span>
      <h1>{destination.h1}</h1>
      <span class="destination-hero__marker" aria-hidden="true">{destination.marker}</span>
    </div>
  </header>

  <section class:list={["section", tone === "earth" && "section--soft"]} aria-labelledby="destination-story-title">
    <div class="container destination-story">
      <div>
        <span class="eyebrow">Información del destino</span>
        <h2 class="destination-story__lede" id="destination-story-title">Qué conocer en {destination.name}</h2>
      </div>
      <div class="destination-story__copy">
        <p>{destination.intro}</p>
        <p>{destination.perspective}</p>
        <ul class="destination-highlights">{destination.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
        <div class="destination-story__links">
          <a class="text-link" href={`/tours/${destination.tourSlug}/`}>{destination.tourLinkLabel} <ArrowUpRight size={19} aria-hidden="true" /></a>
          <a class="text-link" href="/tours/selva-central-4-dias/">Ver tour de 4 días <ArrowUpRight size={19} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

  <JungleInterlude />

  <section class="section section--soft" aria-labelledby="next-stops-title">
    <div class="container content-grid">
      <div><span class="eyebrow">Otros destinos</span><h2 id="next-stops-title" style="font-size: clamp(2.4rem, 5vw, 4.8rem); margin-top: 1rem;">Conoce más destinos de la Selva Central</h2></div>
      <ul class="related-destinations">
        {related.map((item) => <li><a href={`/destinos/${item.slug}/`}><span>{item.marker} · {item.name}</span><ArrowUpRight size={19} aria-hidden="true" /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="cta-route" aria-labelledby="destination-cta-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">Consulta directa</span><h2 id="destination-cta-title">Consulta tours que visitan {destination.name}</h2></div>
      <div class="cta-route__actions"><WhatsAppCTA label="Consultar por WhatsApp" /></div>
    </div>
  </section>
</BaseLayout>
