---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import JungleInterlude from "../components/JungleInterlude.astro";
import { SITE_URL, phoneHref, siteConfig } from "../data/site";
import { brandLogo } from "../data/images";
import { breadcrumbSchema } from "../data/seo";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "@id": `${SITE_URL}/#organization`,
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  legalName: siteConfig.name,
  description: siteConfig.description,
  url: SITE_URL,
  logo: new URL(brandLogo.src, SITE_URL).toString(),
  telephone: siteConfig.primaryWhatsApp,
  taxID: siteConfig.ruc,
  foundingDate: "2018",
  priceRange: "S/30–S/930",
  areaServed: ["Oxapampa", "Pasco", "Selva Central", "Perú"],
  knowsLanguage: ["es-PE"],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: siteConfig.primaryWhatsApp,
    contactType: "reservas y atención al viajero",
    availableLanguage: ["es"],
    areaServed: "PE",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: siteConfig.location.street,
    addressLocality: siteConfig.location.city,
    addressRegion: siteConfig.location.region,
    addressCountry: siteConfig.location.country,
  },
  sameAs: Object.values(siteConfig.socials),
};
const schema = [organizationSchema, breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Contacto", path: "/contacto/" },
])];
---

<BaseLayout title="Contacto | Tangarana Travel Tours Oxapampa" description="Contacta con Tangarana Travel Tours por WhatsApp, teléfono o redes sociales. Consulta tours, paquetes, precios y disponibilidad." schema={schema}>
  <PageIntro
    eyebrow="Contacto directo"
    title="Contacta con Tangarana Travel Tours"
    description="Consulta la disponibilidad y los detalles de un tour o paquete por WhatsApp. Te atenderá directamente el equipo de Tangarana Travel Tours."
    crumbs={[{ label: "Inicio", href: "/" }, { label: "Contacto" }]}
    variant="contact"
    image="waterPause"
    marker="W"
    note={`WhatsApp ${siteConfig.primaryWhatsAppDisplay}`}
  />
  <section class="section" aria-labelledby="contact-title">
    <div class="container contact-board">
      <div class="contact-board__primary"><span class="eyebrow">Canal principal</span><h2 id="contact-title">Consulta por WhatsApp</h2><p>Indica qué tour o paquete te interesa. El equipo confirmará la fecha, disponibilidad y detalles pendientes.</p><WhatsAppCTA label={`WhatsApp ${siteConfig.primaryWhatsAppDisplay}`} /></div>
      <dl class="contact-board__details">
        <div><dt>Dirección</dt><dd>{siteConfig.location.display}</dd></div>
        <div><dt>RUC</dt><dd>{siteConfig.ruc}</dd></div>
        {siteConfig.phones.map((phone, index) => <div><dt>{index === 0 ? "WhatsApp principal" : `Teléfono ${index + 1}`}</dt><dd><a href={phoneHref(phone)}>{phone.replace("+51", "+51 ")}</a></dd></div>)}
        <div><dt>Instagram</dt><dd><a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer">@tangaranatraveltours_2026</a></dd></div>
        <div><dt>Facebook</dt><dd><a href={siteConfig.socials.facebook} target="_blank" rel="noopener noreferrer">Tangarana Travel Tours</a></dd></div>
        <div><dt>TikTok</dt><dd><a href={siteConfig.socials.tiktok} target="_blank" rel="noopener noreferrer">@tangarana_travel_tours</a></dd></div>
      </dl>
    </div>
  </section>
  <JungleInterlude variant="to-forest" />
</BaseLayout>
