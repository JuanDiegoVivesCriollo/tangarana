---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroExpedition from "../components/HeroExpedition.astro";
import DestinationEditorial from "../components/DestinationEditorial.astro";
import IncludesBand from "../components/IncludesBand.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import ExperienceFieldnotes from "../components/ExperienceFieldnotes.astro";
import JourneyMoments from "../components/JourneyMoments.astro";
import DayTourCollection from "../components/DayTourCollection.astro";
import JungleInterlude from "../components/JungleInterlude.astro";
import StayPackageCard from "../components/StayPackageCard.astro";
import { destinations } from "../data/destinations";
import { faqItems } from "../data/faq";
import { stayPackages } from "../data/stayPackages";
import { SITE_URL, siteConfig } from "../data/site";
import { brandLogo } from "../data/images";

const publishedTours = await getCollection("tours", ({ data }) => data.status === "published" && data.kind === "day-tour" && data.indexable);
const dayTourOrder = ["perene", "villa-rica", "yanachaga-chemillen"];
const dayTours = dayTourOrder.map((slug) => publishedTours.find(({ data }) => data.slug === slug)!.data);
const featuredPackage = stayPackages[2];
const homeFaq = faqItems.slice(0, 4);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    name: siteConfig.name,
    alternateName: [siteConfig.shortName, "Tangarana Tours", "tangaranatours.com"],
    url: SITE_URL,
    inLanguage: "es-PE",
  },
  {
    "@context": "https://schema.org",
    "@type": ["TravelAgency", "Organization"],
    "@id": `${SITE_URL}/#organization`,
    name: siteConfig.name,
    alternateName: siteConfig.shortName,
    legalName: siteConfig.name,
    description: siteConfig.description,
    url: SITE_URL,
    logo: new URL(brandLogo.src, SITE_URL).toString(),
    telephone: siteConfig.primaryWhatsApp,
    taxID: siteConfig.ruc,
    foundingDate: "2018",
    priceRange: "S/30–S/930",
    areaServed: ["Oxapampa", "Pasco", "Selva Central", "Perú"],
    knowsLanguage: ["es-PE"],
    contactPoint: {
      "@type": "ContactPoint",
      telephone: siteConfig.primaryWhatsApp,
      contactType: "reservas y atención al viajero",
      availableLanguage: ["es"],
      areaServed: "PE",
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: siteConfig.location.street,
      addressLocality: siteConfig.location.city,
      addressRegion: siteConfig.location.region,
      addressCountry: siteConfig.location.country,
    },
    sameAs: Object.values(siteConfig.socials),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: homeFaq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Tours y paquetes en Oxapampa | Tangarana Travel Tours"
  description="Descubre tours individuales y paquetes con alojamiento por Oxapampa, Pozuzo, Villa Rica, Valle del Perené, Chontabamba, Río Tigre y Yanachaga Chemillén."
  schema={schema}
>
  <HeroExpedition />

  <section class="section home-featured" id="ruta" aria-labelledby="home-package-title">
    <div class="container home-stay-package">
      <SectionHeading eyebrow="Paquete recomendado" title="Tours, alojamiento y desayunos en un solo programa" id="home-package-title">
        <p>Viaja cuatro días con una tarifa clara según el tipo de habitación y revisa el itinerario completo antes de solicitar disponibilidad.</p>
      </SectionHeading>
      {featuredPackage && <StayPackageCard item={featuredPackage} index={2} />}
      <a class="text-link home-day-tours__link" href="/paquetes/">Comparar los cuatro paquetes</a>
    </div>
  </section>

  <ExperienceFieldnotes id="home-experiences-title" tone="soft" />

  <section class="section home-day-tours" aria-labelledby="home-day-tours-title">
    <div class="container">
      <SectionHeading eyebrow="Tours individuales" title="Elige un destino para el día" id="home-day-tours-title">
        <p>Compara Valle del Perené, Villa Rica y Yanachaga Chemillén. Cada página muestra la tarifa y lo que harás.</p>
      </SectionHeading>
      <DayTourCollection tours={dayTours} compact />
      <a class="text-link home-day-tours__link" href="/tours/">Ver todos los tours</a>
    </div>
  </section>

  <JungleInterlude variant="to-forest" />

  <section class="section section--forest" aria-labelledby="included-title">
    <div class="container route-values">
      <div class="route-values__copy">
        <span class="eyebrow">Viaja con claridad</span>
        <h2 id="included-title">Qué incluye un paquete Tangarana</h2>
        <p>Los paquetes reúnen tours, alojamiento, desayunos, recepción en el terminal, movilidad turística y guiado. Cada ficha indica sus exclusiones y condiciones.</p>
      </div>
      {featuredPackage && <IncludesBand labels={featuredPackage.includes.slice(0, 6)} />}
    </div>
  </section>

  <section class="home-destinations" aria-labelledby="destinations-title">
    <div class="container">
      <SectionHeading eyebrow="Información de destinos" title="Conoce la Selva Central" id="destinations-title">
        <p>Consulta información de Oxapampa, Pozuzo, Villa Rica, Valle del Perené y Yanachaga Chemillén, y encuentra los tours relacionados.</p>
      </SectionHeading>
      <DestinationEditorial destinations={destinations} />
    </div>
  </section>

  <JourneyMoments id="journey-moments-title" />

  <section class="section" aria-labelledby="faq-title">
    <div class="container content-grid">
      <SectionHeading eyebrow="Antes de reservar" title="Información sobre precios, horarios e inclusiones" id="faq-title">
        <p>Respuestas claras con los datos disponibles. Si necesitas confirmar fechas o condiciones, escríbenos por WhatsApp.</p>
      </SectionHeading>
      <div>
        <FAQAccordion items={homeFaq} />
        <a class="text-link" href="/preguntas-frecuentes/">Ver todas las preguntas</a>
      </div>
    </div>
  </section>

  <section class="cta-route" aria-labelledby="cta-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">Elige cómo viajar</span><h2 id="cta-title">Un tour por destino o un paquete completo</h2></div>
      <div class="cta-route__actions"><a class="button button-primary" href="/paquetes/">Ver paquetes</a><a class="button button-ink-outline" href="/tours/">Ver tours</a></div>
    </div>
  </section>
</BaseLayout>
