---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { Backpack, Check, ChevronDown, Clock3, MapPin, Play, ShieldCheck, X } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BrandMark from "../../components/BrandMark.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQAccordion from "../../components/FAQAccordion.astro";
import PackageGallery from "../../components/PackageGallery.astro";
import PackageReservationPanel from "../../components/PackageReservationPanel.astro";
import RelatedPackageRail from "../../components/RelatedPackageRail.astro";
import ReserveButton from "../../components/ReserveButton.astro";
import { packageDetails, type PackageDetail } from "../../data/packageDetails";
import { packageCover, packagePhotos, packageVideos } from "../../data/packageMedia";
import { SITE_URL, siteConfig } from "../../data/site";
import { breadcrumbSchema } from "../../data/seo";

export async function getStaticPaths() {
  const entries = await getCollection("tours", ({ data }) => data.status === "published");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const item = entry.data;
const isDayPackage = item.kind === "day-tour";
const canonicalPath = `/tours/${item.slug}/`;
const photos = packagePhotos[item.slug] ?? [];
const cover = packageCover(item.slug);
const video = packageVideos[item.slug];
const videoPoster = video && cover
  ? await getImage({ src: cover.src, width: 720, format: "webp", quality: 78 })
  : undefined;
const details: PackageDetail = packageDetails[item.slug] ?? {
  summary: item.shortDescription,
  highlights: item.activities.map((title: string) => ({ title, description: "Parada incluida en el recorrido publicado." })),
  includes: item.includes,
  beforeBooking: ["La fecha, disponibilidad y condiciones se confirman por WhatsApp."],
  bring: ["Ropa cómoda", "Protector solar y repelente"],
};
const highlightPhotos = await Promise.all(details.highlights.map(async (highlight, index) => {
  const fallbackIndex = photos.length ? index % photos.length : -1;
  const requestedIndices = highlight.imageIndices?.length
    ? highlight.imageIndices
    : [highlight.imageIndex ?? fallbackIndex];
  const uniqueIndices = [...new Set(requestedIndices)].slice(0, 2);

  const optimizedPhotos = await Promise.all(uniqueIndices.map(async (photoIndex) => {
    const photo = photos[photoIndex];
    if (!photo) return undefined;

    const width = Math.min(520, photo.src.width);
    const height = Math.round(width * photo.src.height / photo.src.width);
    const optimized = await getImage({ src: photo.src, width, format: "webp", quality: 74 });
    return { src: optimized.src, alt: photo.alt, width, height };
  }));

  return optimizedPhotos.filter((photo): photo is NonNullable<typeof photo> => Boolean(photo));
}));
const hasEmbeddedHighlightVideo = Boolean(video && details.highlights.some((highlight) => highlight.videoSrc === video.src));
const allPackages = await getCollection("tours", ({ data }) => data.status === "published" && data.indexable);
const relatedPackages = allPackages
  .filter(({ data }) => data.slug !== item.slug)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.price - b.data.price)
  .map(({ data }) => data);
const schedule = details.scheduleNote ?? (item.scheduleStart && item.scheduleEnd ? `${item.scheduleStart} a ${item.scheduleEnd}` : item.durationLabel);
const itemNameLower = item.commercialName.replace(/^Tour/, "el tour");
const tourFaq = [
  { question: `¿Cuánto cuesta ${itemNameLower}?`, answer: `La tarifa publicada es S/${item.price} por persona. El total estimado cambia según la cantidad de viajeros.` },
  { question: "¿Tengo que elegir una fecha ahora?", answer: "No. La fecha y la disponibilidad se confirman directamente con Tangarana por WhatsApp." },
  { question: "¿La solicitud confirma automáticamente la reserva?", answer: "No. El formulario prepara la solicitud; el equipo confirma disponibilidad, condiciones y pago por WhatsApp." },
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TouristTrip",
    name: item.title,
    description: item.seoDescription,
    url: new URL(canonicalPath, SITE_URL).toString(),
    image: cover ? new URL(cover.src.src, SITE_URL).toString() : undefined,
    itinerary: item.destinations.map((name) => ({ "@type": "Place", name })),
    provider: { "@type": "TravelAgency", name: siteConfig.name, url: SITE_URL, taxID: siteConfig.ruc },
    offers: { "@type": "Offer", price: item.price, priceCurrency: item.currency, url: new URL(canonicalPath, SITE_URL).toString() },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: tourFaq.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
  },
  breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Tours", path: "/tours/" },
    { name: item.commercialName, path: canonicalPath },
  ]),
];
---

<BaseLayout
  title={item.seoTitle}
  description={item.seoDescription}
  canonicalPath={canonicalPath}
  schema={schema}
  noindex={!item.indexable}
  socialImage={cover?.src.src}
  socialImageAlt={cover?.alt}
>
  <header class="package-hero">
    <div class="package-hero__gallery">
      <PackageGallery photos={photos} packageName={item.commercialName} />
    </div>
    <div class="package-hero__content">
      <div class="package-hero__brand"><BrandMark /></div>
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Tours", href: "/tours/" }, { label: item.commercialName }]} />
      <span class="eyebrow">{isDayPackage ? item.durationLabel : "Tour por la Selva Central"}</span>
      <h1>{item.commercialName}</h1>
      <p>{details.summary}</p>
      <div class="package-hero__meta">
        <span><Clock3 size={18} aria-hidden="true" /> {schedule}</span>
        <span><MapPin size={18} aria-hidden="true" /> {item.destinations.join(" · ")}</span>
      </div>
      <div class="package-hero__actions">
        <ReserveButton label="Reservar este tour" tourSlug={item.slug} />
        <a class="text-link text-link--light" href="#detalle-tour">Ver lo que ofrece ↓</a>
      </div>
      <div class="package-hero__price"><small>Tarifa por persona</small><strong>S/{item.price}</strong><span>Fecha por confirmar</span></div>
    </div>
  </header>

  <section class="package-detail section" id="detalle-tour" aria-labelledby="package-detail-title">
    <div class="container package-detail__layout">
      <div class="package-detail__content">
        <div class="package-detail__intro">
          <span class="eyebrow">Detalle del tour</span>
          <h2 id="package-detail-title">Lo que harás</h2>
          <p>{details.summary}</p>
          <div class="package-detail__schedule"><Clock3 size={21} aria-hidden="true" /><span><small>Horario o duración</small><strong>{schedule}</strong></span></div>
        </div>

        <ol class="package-highlights">
          {details.highlights.map((highlight, index) => (
            <li>
              <details class="package-highlight">
                <summary>
                  <span class="package-highlight__number">{String(index + 1).padStart(2, "0")}</span>
                  <span class="package-highlight__heading">
                    <span class="package-highlight__title" role="heading" aria-level="3">{highlight.title}</span>
                    <span class="package-highlight__summary">{highlight.description}</span>
                  </span>
                  <span class="package-highlight__toggle" aria-hidden="true">
                    <span class="package-highlight__more">Ver más</span>
                    <span class="package-highlight__less">Ver menos</span>
                    <ChevronDown size={20} stroke-width={1.8} />
                  </span>
                </summary>
                <div class:list={["package-highlight__detail", !highlightPhotos[index]?.length && "package-highlight__detail--text-only"]}>
                  {highlightPhotos[index]?.length > 0 && (
                    <figure class:list={[
                      "package-highlight__media",
                      highlightPhotos[index].length > 1 && "package-highlight__media--pair",
                      highlight.imageFit === "contain" && "package-highlight__media--contain",
                    ]}>
                      {highlightPhotos[index].map((photo) => (
                        <img
                          src={photo.src}
                          alt={photo.alt}
                          width={photo.width}
                          height={photo.height}
                          loading="lazy"
                          decoding="async"
                        />
                      ))}
                    </figure>
                  )}
                  <div class="package-highlight__copy">
                    {(highlight.details?.length ? highlight.details : [highlight.description]).map((paragraph) => <p>{paragraph}</p>)}
                    {highlight.videoSrc && (
                      <button class="package-highlight__video-button" type="button" data-highlight-video-open={`highlight-video-${index}`}>
                        <Play size={17} fill="currentColor" aria-hidden="true" />
                        {highlight.videoLabel ?? "Ver video"}
                      </button>
                    )}
                  </div>
                </div>
              </details>
              {highlight.videoSrc && (
                <dialog class="highlight-video-dialog" id={`highlight-video-${index}`} data-highlight-video-dialog>
                  <div class="highlight-video-dialog__panel">
                    <div class="highlight-video-dialog__header">
                      <div><small>Experiencia real</small><strong>{highlight.title}</strong></div>
                      <button type="button" data-highlight-video-close aria-label="Cerrar video"><X size={22} aria-hidden="true" /></button>
                    </div>
                    <video controls playsinline preload="none">
                      <source src={highlight.videoSrc} type="video/mp4" />
                      Tu navegador no puede reproducir este video.
                    </video>
                  </div>
                </dialog>
              )}
            </li>
          ))}
        </ol>

        <div class="package-facts">
          <article>
            <div class="package-facts__title"><Check size={20} aria-hidden="true" /><h3>Incluye</h3></div>
            <ul>{details.includes.map((label) => <li>{label}</li>)}</ul>
          </article>
          <article>
            <div class="package-facts__title"><ShieldCheck size={20} aria-hidden="true" /><h3>Antes de reservar</h3></div>
            <ul>{details.beforeBooking.map((label) => <li>{label}</li>)}</ul>
          </article>
          <article>
            <div class="package-facts__title"><Backpack size={20} aria-hidden="true" /><h3>Qué llevar</h3></div>
            <ul>{details.bring.map((label) => <li>{label}</li>)}</ul>
          </article>
        </div>

        <div class="package-inline-booking">
          <div><strong>¿Este tour es para ti?</strong><span>Solicita disponibilidad sin volver al inicio.</span></div>
          <ReserveButton label="Reservar este tour" tourSlug={item.slug} />
        </div>
      </div>

      <PackageReservationPanel item={item} childPriceFactor={details.childPriceFactor} />
    </div>
  </section>

  {video && !hasEmbeddedHighlightVideo && (
    <section class="package-video-section section" aria-labelledby="package-video-title">
      <div class="container package-video-section__layout">
        <div>
          <span class="eyebrow">Experiencia real</span>
          <h2 id="package-video-title">Mira cómo se vive {item.destinations[0]}</h2>
          <p>Video breve del recorrido. La reproducción empieza solo cuando tú lo decides.</p>
        </div>
        <video controls playsinline preload="none" poster={videoPoster?.src} aria-label={video.label}>
          <source src={video.src} type="video/mp4" />
          Tu navegador no puede reproducir este video.
        </video>
      </div>
    </section>
  )}

  <script>
    const bindHighlightVideos = () => {
      document.querySelectorAll<HTMLButtonElement>("[data-highlight-video-open]").forEach((button) => {
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";
        button.addEventListener("click", () => {
          const dialog = document.getElementById(button.dataset.highlightVideoOpen ?? "") as HTMLDialogElement | null;
          dialog?.showModal();
        });
      });

      document.querySelectorAll<HTMLDialogElement>("[data-highlight-video-dialog]").forEach((dialog) => {
        if (dialog.dataset.bound === "true") return;
        dialog.dataset.bound = "true";
        dialog.querySelector<HTMLButtonElement>("[data-highlight-video-close]")?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener("close", () => {
          const player = dialog.querySelector<HTMLVideoElement>("video");
          player?.pause();
        });
      });
    };

    bindHighlightVideos();
    document.addEventListener("astro:page-load", bindHighlightVideos);
  </script>

  <section class="related-package-section section" aria-labelledby="related-packages-title">
    <div class="container">
      <div class="related-package-section__head">
        <div><span class="eyebrow">Otros tours</span><h2 id="related-packages-title">Sigue explorando</h2></div>
        <p>Desliza las tarjetas o usa las flechas para comparar otros recorridos.</p>
      </div>
      <RelatedPackageRail items={relatedPackages} />
    </div>
  </section>

  <section class="section package-faq" aria-labelledby="package-faq-title">
    <div class="container content-grid">
      <div><span class="eyebrow">Respuesta directa</span><h2 id="package-faq-title" class="display-section-title">Antes de enviar tu solicitud</h2></div>
      <FAQAccordion items={tourFaq} />
    </div>
  </section>

  <section class="cta-route" aria-labelledby="book-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">Menos pasos</span><h2 id="book-title">Consulta una fecha disponible</h2></div>
      <div class="cta-route__actions"><ReserveButton label="Reservar este tour" tourSlug={item.slug} class="button-dark" /></div>
    </div>
  </section>
</BaseLayout>
