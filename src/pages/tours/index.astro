---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import TourFeature from "../../components/TourFeature.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import DayTourCollection from "../../components/DayTourCollection.astro";
import SectionHeading from "../../components/SectionHeading.astro";
const tours = await getCollection("tours", ({ data }) => data.status === "published");
const featuredTour = tours.find(({ data }) => data.kind === "multi-day")!;
const dayTourOrder = ["perene", "villa-rica", "pozuzo", "chontabamba", "catarata-rio-tigre"];
const dayTours = dayTourOrder.map((slug) => tours.find(({ data }) => data.slug === slug)!.data);
---

<BaseLayout
  title="Tours a Pozuzo, Villa Rica y Perené | Tangarana Travel Tours"
  description="Compara tours a Pozuzo, Villa Rica, Valle del Perené, Chontabamba, Catarata Río Tigre y el circuito de 4 días de Tangarana Travel Tours. Consulta horarios, itinerarios y precios."
>
  <PageIntro
    eyebrow="Tours y excursiones"
    title="Tours a Pozuzo, Villa Rica, Perené y más"
    description="Compara cinco tours de un día y un paquete de cuatro días. Revisa precios, horarios e itinerarios antes de consultar disponibilidad."
    crumbs={[{ label: "Inicio", href: "/" }, { label: "Tours" }]}
    variant="tours"
    image="airBike"
    marker="06"
    note="Precios publicados de S/30 a S/370 por persona"
  />
  <section class="section tours-catalog" aria-labelledby="day-tours-title">
    <div class="container">
      <SectionHeading eyebrow="Tours de un día" title="Precios, horarios e itinerarios" id="day-tours-title">
        <p>Compara horarios, precios y paradas antes de elegir. Consulta por WhatsApp la disponibilidad y el orden final del recorrido.</p>
      </SectionHeading>
      <DayTourCollection tours={dayTours} />
    </div>
  </section>
  <section class="section section--soft" aria-labelledby="expedition-title">
    <div class="container">
      <SectionHeading eyebrow="Paquete de 4 días" title="Tour por Oxapampa, Pozuzo, Villa Rica y Perené" id="expedition-title">
        <p>Oxapampa, Pozuzo, Villa Rica y el Valle del Perené en un solo programa con alojamiento, desayunos y acompañamiento.</p>
      </SectionHeading>
      <TourFeature tour={featuredTour.data} />
    </div>
  </section>
  <section class="cta-route" aria-labelledby="tour-help-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">Contacto directo</span><h2 id="tour-help-title">Consulta fechas y disponibilidad</h2></div>
      <div class="cta-route__actions"><WhatsAppCTA label="Consultar disponibilidad" /></div>
    </div>
  </section>
</BaseLayout>
