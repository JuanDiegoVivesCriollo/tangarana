---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import TourFeature from "../../components/TourFeature.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import DayTourCollection from "../../components/DayTourCollection.astro";
import SectionHeading from "../../components/SectionHeading.astro";
const tours = await getCollection("tours", ({ data }) => data.status === "published");
const featuredTour = tours.find(({ data }) => data.kind === "multi-day")!;
const dayTourOrder = ["perene-dia-completo", "villa-rica-dia-completo", "pozuzo-dia-completo", "chontabamba-medio-dia", "catarata-rio-tigre"];
const dayTours = dayTourOrder.map((slug) => tours.find(({ data }) => data.slug === slug)!.data);
---

<BaseLayout
  title="Tours por la Selva Central del Perú"
  description="Explora tours por Oxapampa, Pozuzo, Villa Rica y el Valle del Perené con información clara de duración, precio e inclusiones."
>
  <PageIntro
    eyebrow="Cartelera de rutas"
    title="Elige cuánto tiempo quieres estar afuera"
    description="Cinco excursiones de un día y una expedición de cuatro jornadas. Horarios, paradas y precios reunidos para comparar sin perderte."
    crumbs={[{ label: "Inicio", href: "/" }, { label: "Tours" }]}
    variant="tours"
    image="airBike"
    marker="06"
    note="Desde S/30 por persona"
  />
  <section class="section tours-catalog" aria-labelledby="day-tours-title">
    <div class="container">
      <SectionHeading eyebrow="Excursiones" title="Rutas que caben en un día." id="day-tours-title">
        <p>Compara horarios, precios y paradas antes de elegir. El orden del recorrido puede ajustarse según la fecha y las condiciones del viaje.</p>
      </SectionHeading>
      <DayTourCollection tours={dayTours} />
    </div>
  </section>
  <section class="section section--soft" aria-labelledby="expedition-title">
    <div class="container">
      <SectionHeading eyebrow="Expedición principal" title="Cuatro días para unir toda la ruta." id="expedition-title">
        <p>Oxapampa, Pozuzo, Villa Rica y el Valle del Perené en un solo programa con alojamiento, desayunos y acompañamiento.</p>
      </SectionHeading>
      <TourFeature tour={featuredTour.data} />
    </div>
  </section>
  <section class="cta-route" aria-labelledby="tour-help-title">
    <div class="container cta-route__inner">
      <div><span class="eyebrow">¿Tienes una fecha en mente?</span><h2 id="tour-help-title">Conversemos sobre tu ruta.</h2></div>
      <div class="cta-route__actions"><WhatsAppCTA label="Consultar disponibilidad" /></div>
    </div>
  </section>
</BaseLayout>
