---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada" description="La página solicitada no existe o cambió de dirección." noindex>
  <section class="error-route">
    <div class="error-route__inner"><span class="error-route__code" aria-hidden="true">404</span><span class="eyebrow">Error 404</span><h1>Página no encontrada</h1><p>La dirección no existe o la página fue movida.</p><div class="error-route__actions"><a class="button button-primary" href="/">Volver al inicio</a><a class="button button-secondary" href="/tours/">Ver tours</a><a class="button button-secondary" href="/paquetes/">Ver paquetes</a></div></div>
  </section>
</BaseLayout>
